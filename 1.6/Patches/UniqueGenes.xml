<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <Operation Class="VEF.PatchOperationToggableSequence">
        <enabled>false</enabled>
        <label>Enable content genes:</label>
        <operations>
            <li Class="PatchOperationAdd">
                <xpath>Defs/XenotypeDef[defName="OCARINA_Anthroracc"]/genes</xpath>
                <value>
                    <li>NakedSpeed</li>
                    <li>MinTemp_SmallDecrease</li>
                    <li>ElongatedFingers</li>
                    <li>Mood_Optimist</li>
                    <li MayRequire="sarg.alphagenes">AG_SmallerBodySize</li>
