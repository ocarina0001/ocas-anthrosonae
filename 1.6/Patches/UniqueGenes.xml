                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/XenotypeDef[defName="OCARINA_Anthroskunk"]/genes</xpath>
                <value>
                    <li>NakedSpeed</li>
                    <li>MaxTemp_SmallDecrease</li>
                    <li>MinTemp_SmallDecrease</li>
                    <li MayRequire="sarg.alphagenes">AG_SmallerBodySize</li>
                    <li MayRequire="sarg.alphagenes">AG_Filthy</li>
                    <li MayRequire="sarg.alphagenes">AG_Stinky</li>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/XenotypeDef[defName="OCARINA_Anthroboghound"]/genes</xpath>
                <value>
                    <li>Aggression_Aggressive</li>
                    <li>Instability_Mild</li>
