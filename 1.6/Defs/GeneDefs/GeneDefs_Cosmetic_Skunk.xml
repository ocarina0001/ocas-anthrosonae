<?xml version="1.0" encoding="UTF-8"?>
<Defs>

    <GeneDef ParentName="ATK_AnthrosonaFurBase">
        <defName>OCARINA_AnthroskunkFur</defName>
        <label>anthroskunk fur</label>
        <labelShortAdj>anthroskunk furred</labelShortAdj>
        <description>Carriers of this gene grow skunk-like fur all over their body.</description>
        <iconPath>UI/Icons/Genes/Anthrosonae/Gene_AnthroskunkFur</iconPath>
        <skinColorOverride>(255,255,255)</skinColorOverride>
        <forcedHeadTypes>
            <li>OCARINA_Anthroskunk_Average_Male</li>
            <li>OCARINA_Anthroskunk_Average_Female</li>
        </forcedHeadTypes>
        <fur>OCARINA_Anthroskunk</fur>
        <modExtensions>
            <li Class="Anthrosonae.FurColors">
                <allowedFurColors>
                    <li>OCARINA_FurPreset_Skunk</li>
                    <li>OCARINA_FurPreset_SkunkAlt</li>
                    <li>OCARINA_FurPreset_SkunkDark</li>
                    <li>OCARINA_FurPreset_Pepper</li>
                    <li>OCARINA_FurPreset_Fifi</li>
                    <li>OCARINA_FurPreset_Petunia</li>
                </allowedFurColors>
            </li>
        </modExtensions>
    </GeneDef>
    <GeneDef ParentName="ATK_AnthrosonaEarsBase">
        <defName>OCARINA_AnthroskunkEars</defName>
        <label>anthroskunk ears</label>
        <description>Carriers of this gene have skunk-like ears.</description>
        <iconPath>UI/Icons/Genes/Anthrosonae/Gene_AnthroskunkEars</iconPath>
        <renderNodeProperties>
            <li>
                <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
                <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
                <texPath>Things/Pawn/Humanlike/Anthrosonae/HeadAttachments/Ears/AnthroskunkEars</texPath>
                <shaderTypeDef>CutoutComplex</shaderTypeDef>
                <colorType>Hair</colorType>
                <parentTagDef>Head</parentTagDef>
                <useRottenColor>true</useRottenColor>
                <rotDrawMode>Fresh,Rotting</rotDrawMode>
                <drawData>
                    <defaultData>
                        <layer>70</layer>
                    </defaultData>
                </drawData>
            </li>
        </renderNodeProperties>
    </GeneDef>
    <GeneDef ParentName="ATK_AnthrosonaTailBase">
        <defName>OCARINA_AnthroskunkTail</defName>
        <label>anthroskunk tail</label>
        <description>Carriers of this gene have a skunk-like tail.</description>
        <iconPath>UI/Icons/Genes/Anthrosonae/Gene_AnthroskunkTail</iconPath>
        <renderNodeProperties>
            <li>
                <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
                <texPath>Things/Pawn/Humanlike/Anthrosonae/BodyAttachments/Tails/AnthroskunkTail</texPath>
                <shaderTypeDef>CutoutComplex</shaderTypeDef>
                <colorType>Hair</colorType>
                <overrideMeshSize>(1.2,1.2)</overrideMeshSize>
                <parentTagDef>Body</parentTagDef>
                <rotDrawMode>Fresh,Rotting</rotDrawMode>
                <drawData>
                    <scaleOffsetByBodySize>false</scaleOffsetByBodySize>
                    <defaultData>
                        <layer>-2</layer>
                    </defaultData>
                    <dataNorth>
                        <offset>(0.35,0.03,-0.15)</offset>
                        <layer>90</layer>
                    </dataNorth>
                    <dataSouth>
                        <offset>(-0.35,0,-0.10)</offset>
                    </dataSouth>
                    <dataEast>
                        <offset>(-0.45,0,-0.15)</offset>
                    </dataEast>
                    <dataWest>
                        <offset>(0.45,0,-0.15)</offset>
                    </dataWest>
                </drawData>
            </li>
        </renderNodeProperties>
    </GeneDef>

</Defs>